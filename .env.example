# FOMO unofficial data API (https://fomoapi.io/dashboard)
FOMO_API_KEY=
FOMO_HANDLE=

# Optional overrides if you already know the wallets behind the handle
SOLANA_WALLET=
EVM_WALLET=

# On-chain mark-to-market
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=

# Optional client defaults (baked into the Vite bundle — prefer server env for secrets)
VITE_FOMO_HANDLE=
VITE_SOLANA_WALLET=
VITE_EVM_WALLET=

# Desk chat (OpenAI-compatible). Also accepted from Sources as x-llm-api-key.
# Vercel AI Gateway: AI_GATEWAY_API_KEY + optional AI_GATEWAY_BASE_URL
LLM_API_KEY=
LLM_MODEL=gpt-5.4
LLM_BASE_URL=
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
